# === Java build output ===
out/
*.class
*.log

# === ANTLR generated sources (regenerate with scripts/generate-antlr.ps1) ===
src/antlr/*.tokens
src/antlr/*.interp
src/antlr/*.java
gen/
src/antlr/gen/
# Keep the grammar files themselves
!src/antlr/*.g4

# === JARs: ignore everything except the required ANTLR runtime in lib/ ===
*.jar
!lib/*.jar

# === Python (generated Flask app + local test venvs) ===
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.test-venv/
scripts/.venv/

# === IDE / OS ===
.idea/
.DS_Store
# Ignore IDE folder but keep the shared VS Code settings needed to run the project
.vscode/*
!.vscode/settings.json
